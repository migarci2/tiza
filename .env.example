# Local synthetic demo; copy to .env. Never commit .env.
TIZA_DEMO_MODE=true
TIZA_DEMO_ACCESS_CODE=246810
# Disable reset on a shared judging instance; it remains available locally.
TIZA_DEMO_RESET_ENABLED=true
TIZA_PREPARATIONS_PER_DAY=40
TIZA_MATERIALS_PER_DAY=30
# Global admission cap. Each Bedrock job has at most 3 attempts of 12 model calls.
TIZA_BEDROCK_PREPARATIONS_PER_DAY=10
TIZA_AGENT_MODE=deterministic_demo
TIZA_DATABASE_URL=sqlite:///./data/tiza.db
TIZA_SESSION_SECURE=false
TIZA_SITE_ADDRESS=:80
TIZA_PUBLIC_URL=http://localhost:8080
TIZA_REDIS_URL=redis://localhost:6379/0
TIZA_EMAIL_MODE=mailpit
TIZA_SMTP_HOST=localhost
TIZA_SMTP_PORT=1025
TIZA_EMAIL_FROM=Tiza <practice@tiza.example>
# Production: demo=false, secure=true, agent_mode=bedrock, email_mode=resend.
# TIZA_DATABASE_URL=postgresql+psycopg://...
# TIZA_SUPABASE_URL=https://PROJECT.supabase.co
# TIZA_SUPABASE_ANON_KEY=
# TIZA_SUPABASE_SERVICE_KEY=
# TIZA_SUPABASE_MATERIAL_BUCKET=tiza-materials
# TIZA_BEDROCK_MODEL_ID=validated-model-id-or-inference-profile
# AWS_REGION=eu-west-1
# Prefer an EC2 instance role to static AWS credentials.
# TIZA_RESEND_API_KEY=
# TIZA_NEMA_PRIVATE_KEY_FILE=/run/secrets/tiza-issuer.pem
